        "@rollup/plugin-terser": "^0.4.4",
        "@vitejs/plugin-react": "^4.3.1",
        "esp-js": "*",
        "esp-js-ui": "*",
        "react": "^19.0.0",
        "typescript": "^5.8.0",
        "vite": "^5.4.6",
        "vite-plugin-dts": "^4.2.1",
        "vitest": "^2.1.1"
    },
    "peerDependencies": {
