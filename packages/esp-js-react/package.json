            "require": "./.dist/esp-react.js",
            "default": "./.dist/esp-react.js"
        },
        "./.dist/*": "./.dist/*",
        "./package.json": "./package.json"
    },
    "files": [
        ".dist",
        "NOTICE"
    ],
