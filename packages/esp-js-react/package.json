    },
    "scripts": {
        "clean": "nps clean",
        "build-dev": "nps build-dev",
        "build-prod": "nps build-prod",
        "build-pack": "nps build-pack",
        "test": "nps test",
        "test-ci": "nps test-ci",
        "dev": "nps dev"
    },
