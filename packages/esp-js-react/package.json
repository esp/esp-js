{
    "name": "esp-js-react",
    "version": "9.0.0-beta.1",
    "description": "Evented State Processor (ESP) React Components",
    "keywords": [
        "esp",
        "state processor",
        "evented state processor",
        "reactive",
        "react"
    ],
    "main": ".dist/esp-react.js",
    "module": ".dist/esp-react.esm.mjs",
    "types": ".dist/typings/index.d.ts",
